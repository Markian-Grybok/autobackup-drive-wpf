<Window x:Class="AppCopyDirecToDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppCopyDirecToDrive"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Copy Directory To Drive" Height="900" Width="800"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15 5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFEEEEEE">
        <Border MinWidth="450" Margin="20" Background="White" VerticalAlignment="Center" Padding="30" MaxWidth="600" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="LightGray" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Заголовок -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 20">
                        <materialDesign:PackIcon Kind="FolderMultiple" Width="36" Height="36" Margin="0 0 10 0"/>
                        <TextBlock Text="CopyDirecToDrive" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Панель авторизації -->
                    <Border Background="#FFF5F5F5" CornerRadius="8" Padding="15" Margin="0 0 0 20">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="btnRegister" Content="Login" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Click="Login_Button" Margin="5 0 0 0"/>
                                <Button x:Name="btnLogin" Content="Logout" Style="{StaticResource MaterialDesignRaisedButton}" 
                                        Click="Logout_Button" Margin="5 0 0 0"/>
                            </StackPanel>
                            <TextBlock x:Name="autorisation" Text="Not logged in" FontSize="16" VerticalAlignment="Center" 
                                       Foreground="#FF555555" FontStyle="Italic"/>
                        </DockPanel>
                    </Border>

                    <!-- Панель вибору директорій -->
                    <GroupBox Header="Directory Selection" Margin="0 0 0 20" FontSize="16" FontWeight="Medium">
                        <StackPanel>
                            <Grid Margin="0 10 0 15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="textPath" Grid.Column="0" materialDesign:HintAssist.Hint="Select directory path" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="14"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Click="AddDirectory_Button" ToolTip="Add directory" Margin="0,5,5,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0 0 5 0"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Click="DeleteDirectory_Button" ToolTip="Delete selected directory" Margin="0,5,5,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Margin="0 0 5 0"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Click="Browse_Button" ToolTip="Browse directory" Margin="0,5,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" Margin="0 0 5 0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Список вибраних директорій -->
                            <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="5" Padding="10" MaxHeight="200">
                                <ScrollViewer>
                                    <ListBox x:Name="selectedDirectoriesList" BorderThickness="0" FontSize="16">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0 3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" 
                                                               VerticalAlignment="Center" FontSize="13"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- Поле для введення часу та кнопка Set -->
                    <Grid Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="textTimeInterval" Grid.Column="0" 
                                 materialDesign:HintAssist.Hint="Enter interval (seconds)" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 FontSize="14" Margin="0 0 10 0" Text="0"/>
                        <Button x:Name="btnSetInterval" Grid.Column="1" Content="Set" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Click="SetInterval_Button" Width="100" Height="40" FontWeight="Bold"/>
                    </Grid>

                    <!-- Панель керування -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnStart" Content="START" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Click="Start_Button" Width="120" Height="40" FontWeight="Bold"/>
                        <Button x:Name="btnStop" Content="STOP" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Click="Stop_Button" Width="120" Height="40" Margin="15 0 0 0" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Інформаційний блок -->
                    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="5" Padding="10" Margin="0 10 0 20">
                        <TextBlock x:Name="info" Text="No operations performed" FontSize="14" TextWrapping="Wrap" 
                                   Foreground="#FF555555" FontStyle="Italic" Width="530"/>
                    </Border>
                </StackPanel>

                <!-- About Button -->
                <Button x:Name="btnAbout" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignFlatButton}" Click="AboutButton_Click" 
                        Width="61" Height="30" ToolTip="About the program" Margin="479,-23,0,0">
                    <materialDesign:PackIcon Kind="Information" Width="28" Height="22" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>